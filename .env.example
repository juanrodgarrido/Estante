# Copia este archivo a .env.local y rellena los valores. No subas .env.local al repositorio.

# MongoDB Atlas (cadena de conexión del cluster M0)
MONGODB_URI=
MONGODB_DB=estante

# Better Auth (Sesión 3). Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app: http://localhost:3000 en local, la URL de Vercel en producción
BETTER_AUTH_URL=http://localhost:3000

# Google Books API (Sesión 4)
GOOGLE_BOOKS_API_KEY=
# Email de contacto para la cabecera User-Agent de Open Library (obligatoria; respaldo de Google Books)
OPENLIBRARY_CONTACT_EMAIL=

# Pusher Channels (Sesión 8). Se dejan vacías hasta entonces.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
